  "hardening_profiles": [
    {
      "id": "gcc-randstruct",
      "architecture": "x86",
      "label": "GCC plugin RANDSTRUCT",
      "toolchain": "native-gcc",
      "config_target": "x86_64_defconfig",
      "enable": [
        "GCC_PLUGINS",
        "GCC_PLUGIN_RANDSTRUCT",
        "RANDSTRUCT_FULL"
      ],
      "disable": [
        "WERROR",
        "RUST"
      ],
      "extra_packages": [
        "gcc-13-plugin-dev"
      ]
    },
    {
      "id": "gcc-latent-entropy",
      "architecture": "x86",
      "label": "GCC latent entropy plugin",
      "toolchain": "native-gcc",
      "config_target": "x86_64_defconfig",
      "enable": [
        "GCC_PLUGINS",
        "GCC_PLUGIN_LATENT_ENTROPY"
      ],
      "disable": [
        "WERROR",
        "RUST"
      ],
      "extra_packages": [
        "gcc-13-plugin-dev"
      ]
    },
    {
      "id": "clang-cfi",
      "architecture": "x86",
      "label": "Clang CFI",
      "toolchain": "llvm",
      "config_target": "x86_64_defconfig",
