{
  "schema": 1,
  "source_branch": "rolling-linux-sync",
  "gcc_toolchain": {
    "version": "14.2.0",
    "base_url": "https://www.kernel.org/pub/tools/crosstool/files/bin/x86_64/14.2.0"
  },
  "llvm_toolchain": {
    "version": "22.1.8",
