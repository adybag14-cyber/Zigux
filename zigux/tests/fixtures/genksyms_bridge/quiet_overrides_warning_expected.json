{
  "tool": "scripts/genksyms/genksyms",
  "stdin": "cpp-stream",
  "stdout": "symversions",
  "argv": [
    "scripts/genksyms/genksyms",
    "--warnings",
    "--quiet",
    "--reference",
    "bar.symref"
  ],
  "options": {
    "debug_level": 0,
    "warnings": false,
    "dump_defs": false,
    "preserve": false,
    "reference_files": [
      "bar.symref"
    ],
    "dump_types_file": null
  }
}