{
  "tool": "scripts/genksyms/genksyms",
  "stdin": "cpp-stream",
  "stdout": "symversions",
  "argv": [
    "scripts/genksyms/genksyms",
    "--reference",
    "--debug",
    "--dump-types",
    "--types"
  ],
  "options": {
    "debug_level": 0,
    "warnings": false,
    "dump_defs": false,
    "preserve": false,
    "reference_files": [
      "--debug"
    ],
    "dump_types_file": "--types"
  }
}
