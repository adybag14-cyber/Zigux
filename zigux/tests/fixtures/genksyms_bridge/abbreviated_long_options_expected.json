{
  "tool": "scripts/genksyms/genksyms",
  "stdin": "cpp-stream",
  "stdout": "symversions",
  "argv": [
    "scripts/genksyms/genksyms",
    "--deb",
    "--warn",
    "--qui",
    "--ref=foo.symref",
    "--dump-t",
    "types.symtypes",
    "--pres"
  ],
  "options": {
    "debug_level": 1,
    "warnings": false,
    "dump_defs": false,
    "preserve": true,
    "reference_files": [
      "foo.symref"
    ],
    "dump_types_file": "types.symtypes"
  }
}
