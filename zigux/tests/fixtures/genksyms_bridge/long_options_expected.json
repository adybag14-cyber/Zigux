{
  "tool": "scripts/genksyms/genksyms",
  "stdin": "cpp-stream",
  "stdout": "symversions",
  "argv": [
    "scripts/genksyms/genksyms",
    "--debug",
    "--warnings",
    "--quiet",
    "--reference=foo.symref",
    "--dump-types",
    "types.symtypes",
    "--preserve"
  ],
  "options": {
    "debug_level": 1,
    "warnings": false,
    "dump_defs": false,
    "preserve": true,
    "reference_files": [
      "foo.symref"
    ],
    "dump_types_file": "types.symtypes"
  }
}
