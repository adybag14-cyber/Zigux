{
  "tool": "scripts/genksyms/genksyms",
  "stdin": "cpp-stream",
  "stdout": "symversions",
  "argv": [
    "scripts/genksyms/genksyms",
    "-r",
    "-d",
    "-T",
    "--symtypes"
  ],
  "options": {
    "debug_level": 0,
    "warnings": false,
    "dump_defs": false,
    "preserve": false,
    "reference_files": [
      "-d"
    ],
    "dump_types_file": "--symtypes"
  }
}
